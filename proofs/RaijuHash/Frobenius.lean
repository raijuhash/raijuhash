import RaijuHash.Bits

/-!
# The field modulus is irreducible

`fPoly = X¹²⁸ + X⁷ + X² + X + 1` is the modulus of Rust's `gf_mul`.
Irreducibility follows from a Rabin-style test: `fPoly ∣ X^(2¹²⁸) - X` and
`X^(2⁶⁴) - X` is coprime to `fPoly`. Both facts are checked by the kernel
on natural-number bit representations (`decide +kernel`); the Bezout
coefficients are certificates whose identity is checked, not trusted.
-/


set_option maxRecDepth 20000

namespace RaijuHash
open Polynomial

/-- Rust's field modulus. -/
noncomputable def fPoly : R := X ^ 128 + X ^ 7 + X ^ 2 + X + 1

/-- `fPoly` as bits. -/
def fNat : ℕ := 2 ^ 128 + 0x87

lemma toPoly_fNat : toPoly fNat = fPoly := by
  have h : fNat = 2 ^ 128 ^^^ 2 ^ 7 ^^^ 2 ^ 2 ^^^ 2 ^ 1 ^^^ 2 ^ 0 := by
    rw [fNat]; decide +kernel
  rw [h, toPoly_xor, toPoly_xor, toPoly_xor, toPoly_xor, toPoly_two_pow, toPoly_two_pow,
    toPoly_two_pow, toPoly_two_pow, toPoly_two_pow, fPoly, pow_one, pow_zero]

-- Unfolding `fPoly` during unification would expand `X ^ 128`.
attribute [irreducible] fPoly

/-- An untrusted quotient by `fNat` (long division, for degrees below 256).
    Correctness of `mulmodF` below does not depend on it. -/
def divFAux : ℕ → ℕ → ℕ → ℕ
  | 0, _, q => q
  | k + 1, r, q =>
    if r.testBit (128 + k) then divFAux k (r ^^^ (fNat <<< k)) (q ||| (1 <<< k))
    else divFAux k r q

def divF (n : ℕ) : ℕ := divFAux 128 n 0

/-- Multiplication modulo `fPoly` on bit representations. -/
def mulmodF (a b : ℕ) : ℕ := clmulN a b ^^^ clmulN (divF (clmulN a b)) fNat

lemma mk_mulmodF (a b : ℕ) :
    AdjoinRoot.mk fPoly (toPoly (mulmodF a b)) =
      AdjoinRoot.mk fPoly (toPoly a) * AdjoinRoot.mk fPoly (toPoly b) := by
  simp only [mulmodF, toPoly_xor, toPoly_clmulN, toPoly_fNat, map_add, map_mul,
    AdjoinRoot.mk_self, mul_zero, add_zero]

def sqF (p : ℕ) : ℕ := mulmodF p p

/-- Checks that each listed value is the square of the previous one modulo
    `fPoly`. Every step is a literal computation, so nothing is nested. -/
def squaringChain : ℕ → List ℕ → Bool
  | _, [] => true
  | p, q :: qs => (sqF p == q) && squaringChain q qs

lemma mk_squaringChain (p : ℕ) (qs : List ℕ) (h : squaringChain p qs = true) :
    AdjoinRoot.mk fPoly (toPoly (qs.getLastD p)) =
      AdjoinRoot.mk fPoly (toPoly p) ^ (2 ^ qs.length) := by
  induction qs generalizing p with
  | nil => simp
  | cons q qs ih =>
    simp only [squaringChain, Bool.and_eq_true, beq_iff_eq] at h
    rw [List.getLastD_cons, ih q h.2, ← h.1, sqF, mk_mulmodF, ← pow_two, ← pow_mul,
      List.length_cons, pow_succ, mul_comm 2]

