+/// Whether a read from `p` whose last byte is `p[last_read]`, of a message
+/// whose last byte is `p[last]`, reaches a page past the one holding
+/// `p[last]`. Masked loads never fault on their masked-off bytes, but on Zen 5
+/// a masked load that reaches an inaccessible or not-yet-present page this
+/// way takes a microcode assist of about 120 ns on every call (a message
+/// ending just before a guard page, the end of a mapping, or the untouched
+/// part of a fresh allocation). Such rare messages take a copy instead.
+#[inline(always)]
+pub(crate) fn crosses_page(p: *const u8, last: usize, last_read: usize) -> bool {
+    let a = p as usize;
+    (a + last) ^ (a + last_read) >= 4096
+}
+
+/// `crosses_page` for `len > 0` bytes read in whole blocks of 128.
+#[inline(always)]
+pub(crate) fn blocks_cross_page(p: *const u8, len: usize) -> bool {
+    crosses_page(p, len - 1, (len - 1) | (BLOCK - 1))
